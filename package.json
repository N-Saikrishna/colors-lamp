{
  "name": "colors-lamp",
  "version": "1.0.0",
  "private": true,
  "description": "Linting tools for the Colors LAMP app",
  "license": "MIT",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint \"public/**/*.html\"",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:js": "eslint --max-warnings 0 ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "htmlhint": "^1.9.2",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0"
  }
}
